=LET(
   pEnableEvaluation,TRUE,
   pStatusConflict,"CONFLICT",
   pStatusPotential,"POTENTIAL",
   pStatusOk,"OK",
   pStatusFallback,"POTENTIAL",
   pBitBlockTypes,{"DA","DR","MDI"},
   pTypeAliasKeys,{"BOOL","BOOLEAN","EBOOL","UINT","UNSIGNEDINT","FLOAT","REAL"},
   pTypeAliasCanon,{"EBOOL","EBOOL","EBOOL","UINT","UINT","FLOAT","FLOAT"},
   pTypeKeys,{"EBOOL","UINT","FLOAT"},
   pTypeSpans,{1,1,2},
   infoOnlyNote,"INFO ONLY - table/column names for easy search-and-replace",
   infoTableName,"MASTERV3_DB",
   infoColAddress,"ADDRESS",
   infoColPLC,"PLC",
   infoColRegister,"REGISTER",
   infoColBit,"BIT",
   infoColDataType,"DATA TYPE",
   infoColBlockType,"iFIX BLOCK TYPE",
   normTypeToken,LAMBDA(t,SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER(TRIM(t))," ",""),"_",""),"-","")),
   normBitToken,LAMBDA(b,IF(b="","",IFERROR(TRIM(TEXT(--b,"0.###############")),TRIM(b)))),
   isBitBlock,LAMBDA(b,ISNUMBER(XMATCH(b,pBitBlockTypes,0))),
   IF(
      NOT(pEnableEvaluation),
      "EXECUTION PAUSED",
      LET(
         selfRow,IFERROR(ROW(MASTERV3_DB[@ADDRESS]),ROW()),
         curAddr,IFERROR(MASTERV3_DB[@ADDRESS],""),
         curPLC,IFERROR(MASTERV3_DB[@PLC],""),
         curRegNum,IFERROR(--MASTERV3_DB[@REGISTER],NA()),
         curBitRaw,IFERROR(MASTERV3_DB[@BIT],""),
         curTypeRaw,IFERROR(MASTERV3_DB[@[DATA TYPE]],""),
         curBlk,UPPER(TRIM(IFERROR(MASTERV3_DB[@[iFIX BLOCK TYPE]],""))),
         tblAddr,IFERROR(MASTERV3_DB[ADDRESS],""),
         tblPLC,IFERROR(MASTERV3_DB[PLC],""),
         tblRegRaw,MASTERV3_DB[REGISTER],
         tblBitRaw,MASTERV3_DB[BIT],
         tblTypeRaw,MASTERV3_DB[DATA TYPE],
         tblBlkRaw,MASTERV3_DB[iFIX BLOCK TYPE],
         tblRow,ROW(MASTERV3_DB[ADDRESS]),
         maxKnownSpan,MAX(pTypeSpans),
         status,
         LET(
            normCurPLC,UPPER(TRIM(curPLC)),
            normCurBit,normBitToken(curBitRaw),
            curTypeKey,normTypeToken(curTypeRaw),
            curTypeCanon,XLOOKUP(curTypeKey,pTypeAliasKeys,pTypeAliasCanon,""),
            curIsBitStyle,isBitBlock(curBlk),
            curIsEbool,AND(curIsBitStyle,curTypeCanon="EBOOL"),
            curIsNonEbool,NOT(curIsEbool),
            curHasBit,LEN(normCurBit)>0,
            curWhole,OR(curIsNonEbool,AND(curIsEbool,NOT(curHasBit))),
            curBitSpecific,AND(curIsEbool,curHasBit),
            curBitOK,IF(curIsEbool,OR(curBitRaw="",ISNUMBER(IFERROR(--curBitRaw,NA()))),TRUE),
            curRowGood,AND(curAddr<>"",normCurPLC<>"",ISNUMBER(curRegNum),curBitOK),
            IF(
               NOT(curRowGood),
               pStatusPotential,
               LET(
                  normArrPLC,UPPER(TRIM(tblPLC)),
                  arrRegNum,IFERROR(--tblRegRaw,0),
                  arrRegIsNum,IFERROR(ISNUMBER(--tblRegRaw),FALSE),
                  normArrBit,IFERROR(normBitToken(tblBitRaw),""),
                  arrTypeKey,normTypeToken(IFERROR(tblTypeRaw,"")),
                  normArrBlk,IFERROR(UPPER(TRIM(tblBlkRaw)),""),
                  arrTypeCanon,XLOOKUP(arrTypeKey,pTypeAliasKeys,pTypeAliasCanon,""),
                  arrIsBitStyle,isBitBlock(normArrBlk),
                  arrIsEbool,--arrIsBitStyle*--(arrTypeCanon="EBOOL"),
                  arrIsNonEbool,--NOT(arrIsEbool),
                  otherMask,tblRow<>selfRow,
                  validMask,(tblAddr<>"")*(normArrPLC<>"")*--arrRegIsNum,
                  peerWholeEbool,arrIsEbool*--(normArrBit=""),
                  peerWholeNonEbool,arrIsNonEbool,
                  peerWhole,(peerWholeEbool+peerWholeNonEbool)>0,
                  peerBit,arrIsEbool*--(normArrBit<>""),
                  arrTypeSpanKnown,XLOOKUP(arrTypeCanon,pTypeKeys,pTypeSpans,0),
                  curTypeSpanKnown,XLOOKUP(curTypeCanon,pTypeKeys,pTypeSpans,0),
                  unknownSpan,LET(mx,MAX(arrTypeSpanKnown),IF(mx>0,mx,maxKnownSpan)),
                  arrSpanMax,IF(arrIsEbool,1,IF(arrTypeSpanKnown>0,arrTypeSpanKnown,unknownSpan)),
                  arrSpanMin,IF(arrIsEbool,1,IF(arrTypeSpanKnown>0,arrTypeSpanKnown,1)),
                  curSpanMax,IF(curIsEbool,1,IF(curTypeSpanKnown>0,curTypeSpanKnown,unknownSpan)),
                  curSpanMin,IF(curIsEbool,1,IF(curTypeSpanKnown>0,curTypeSpanKnown,1)),
                  arrEndMax,arrRegNum+arrSpanMax-1,
                  arrEndMin,arrRegNum+arrSpanMin-1,
                  curEndMax,curRegNum+curSpanMax-1,
                  curEndMin,curRegNum+curSpanMin-1,
                  samePLC,normArrPLC=normCurPLC,
                  sameReg,--(arrRegNum=curRegNum),
                  baseMask,--samePLC*--otherMask*--validMask,
                  directConflict,
                  IF(curWhole,SUMPRODUCT(baseMask*--sameReg*--peerWhole),0)+
                  IF(curBitSpecific,SUMPRODUCT(baseMask*--sameReg*--peerBit*--(normArrBit=normCurBit)),0),
                  ovMax,--(arrRegNum<=curEndMax)*--(arrEndMax>=curRegNum),
                  ovDef,--(arrRegNum<=curEndMin)*--(arrEndMin>=curRegNum),
                  ovPot,ovMax*(1-ovDef),
                  defWholeBit,
                  IF(curWhole,SUMPRODUCT(baseMask*--ovMax*--peerBit*--curIsNonEbool),IF(curBitSpecific,SUMPRODUCT(baseMask*--ovMax*--peerWholeNonEbool),0)),
                  potWholeBit,
                  IF(curWhole,SUMPRODUCT(baseMask*--ovMax*--peerBit*--curIsEbool),IF(curBitSpecific,SUMPRODUCT(baseMask*--ovMax*--peerWholeEbool),0)),
                  defRange,SUMPRODUCT(baseMask*--ovDef*--(((--curIsNonEbool)+arrIsNonEbool)>0)),
                  potRange,SUMPRODUCT(baseMask*--ovPot*--(((--curIsNonEbool)+arrIsNonEbool)>0)),
                  IF(directConflict+defWholeBit+defRange>0,pStatusConflict,IF(potWholeBit+potRange>0,pStatusPotential,pStatusOk))
               )
            )
         ),
         IFERROR(status,pStatusFallback)
      )
   )
)