=IF(FALSE,
LET(
   selfRow,IFERROR(ROW(MASTERV2_DB[@ADDRESS]),ROW()),
   curAddr,IFERROR(MASTERV2_DB[@ADDRESS],""),
   curPLC,IFERROR(MASTERV2_DB[@PLC],""),
   curRegNum,IFERROR(--MASTERV2_DB[@REGISTER],NA()),
   curBitRaw,IFERROR(MASTERV2_DB[@BIT],""),
   curTypeRaw,IFERROR(MASTERV2_DB[@[DATA TYPE]],""),
   curBlk,UPPER(TRIM(IFERROR(MASTERV2_DB[@[iFIX BLOCK TYPE]],""))),
   tblAddr,IFERROR(MASTERV2_DB[ADDRESS],""),
   tblPLC,IFERROR(MASTERV2_DB[PLC],""),
   tblRegRaw,MASTERV2_DB[REGISTER],
   tblBitRaw,MASTERV2_DB[BIT],
   tblTypeRaw,MASTERV2_DB[DATA TYPE],
   tblBlkRaw,MASTERV2_DB[iFIX BLOCK TYPE],
   tblRow,ROW(MASTERV2_DB[ADDRESS]),
   normTypeToken,LAMBDA(t,SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER(TRIM(t))," ",""),"_",""),"-","")),
   typeAliasKeys,{"BOOL","BOOLEAN","UINT","UNSIGNEDINT","FLOAT","REAL"},
   typeAliasCanon,{"BOOL","BOOL","UINT","UINT","FLOAT","FLOAT"},
   typeKeys,{"BOOL","UINT","FLOAT"},
   typeSpans,{1,1,2},
   maxKnownSpan,MAX(typeSpans),
   status,
   LET(
         normCurPLC,UPPER(TRIM(curPLC)),
         normCurBit,IF(curBitRaw="","",IFERROR(TRIM(TEXT(--curBitRaw,"0.###############")),TRIM(curBitRaw))),
         curTypeKey,normTypeToken(curTypeRaw),
         curIsBitStyle,OR(curBlk="DA",curBlk="DR",curBlk="MDI"),
         curIsNonBit,NOT(curIsBitStyle),
         curHasBit,LEN(normCurBit)>0,
         curWhole,OR(curIsNonBit,AND(curIsBitStyle,NOT(curHasBit))),
         curBitSpecific,AND(curIsBitStyle,curHasBit),
         curBitOK,IF(curIsBitStyle,OR(curBitRaw="",ISNUMBER(IFERROR(--curBitRaw,NA()))),TRUE),
         curRowGood,AND(curAddr<>"",normCurPLC<>"",ISNUMBER(curRegNum),curBitOK),
         IF(
            NOT(curRowGood),
            "POTENTIAL",
            LET(
               normArrPLC,UPPER(TRIM(tblPLC)),
               arrRegNum,IFERROR(--tblRegRaw,0),
               arrRegIsNum,IFERROR(ISNUMBER(--tblRegRaw),FALSE),
               normArrBit,IFERROR(IF(tblBitRaw="","",IFERROR(TRIM(TEXT(--tblBitRaw,"0.###############")),TRIM(tblBitRaw))),""),
               arrTypeKey,normTypeToken(IFERROR(tblTypeRaw,"")),
               normArrBlk,IFERROR(UPPER(TRIM(tblBlkRaw)),""),
               arrIsBitStyle,(normArrBlk="DA")+(normArrBlk="DR")+(normArrBlk="MDI")>0,
               arrIsNonBit,NOT(arrIsBitStyle),
               otherMask,tblRow<>selfRow,
               validMask,(tblAddr<>"")*(normArrPLC<>"")*--arrRegIsNum,
               peerWhole,((--arrIsNonBit)+(--arrIsBitStyle*--(normArrBit="")))>0,
               peerBit,--arrIsBitStyle*--(normArrBit<>""),
               arrTypeCanon,XLOOKUP(arrTypeKey,typeAliasKeys,typeAliasCanon,""),
               curTypeCanon,XLOOKUP(curTypeKey,typeAliasKeys,typeAliasCanon,""),
               arrTypeSpanKnown,XLOOKUP(arrTypeCanon,typeKeys,typeSpans,0),
               curTypeSpanKnown,XLOOKUP(curTypeCanon,typeKeys,typeSpans,0),
               unknownSpan,LET(mx,MAX(arrTypeSpanKnown),IF(mx>0,mx,maxKnownSpan)),
               arrSpanMax,IF(arrIsBitStyle,1,IF(arrTypeSpanKnown>0,arrTypeSpanKnown,unknownSpan)),
               arrSpanMin,IF(arrIsBitStyle,1,IF(arrTypeSpanKnown>0,arrTypeSpanKnown,1)),
               curSpanMax,IF(curIsBitStyle,1,IF(curTypeSpanKnown>0,curTypeSpanKnown,unknownSpan)),
               curSpanMin,IF(curIsBitStyle,1,IF(curTypeSpanKnown>0,curTypeSpanKnown,1)),
               arrEndMax,arrRegNum+arrSpanMax-1,
               arrEndMin,arrRegNum+arrSpanMin-1,
               curEndMax,curRegNum+curSpanMax-1,
               curEndMin,curRegNum+curSpanMin-1,
               samePLC,normArrPLC=normCurPLC,
               sameReg,--(arrRegNum=curRegNum),
               baseMask,--samePLC*--otherMask*--validMask,
               directConflict,
               IF(curWhole,SUMPRODUCT(baseMask*--sameReg*--peerWhole),0)+
               IF(curBitSpecific,SUMPRODUCT(baseMask*--sameReg*--peerBit*--(normArrBit=normCurBit)),0),
               potWholeBit,
               IF(curWhole,SUMPRODUCT(baseMask*--sameReg*--peerBit),IF(curBitSpecific,SUMPRODUCT(baseMask*--sameReg*--peerWhole),0)),
               ovMax,--(arrRegNum<=curEndMax)*--(arrEndMax>=curRegNum),
               ovDef,--(arrRegNum<=curEndMin)*--(arrEndMin>=curRegNum),
               ovPot,ovMax*(1-ovDef),
               wholeBitPair,sameReg*IF(curWhole,peerBit,IF(curBitSpecific,peerWhole,0)),
               defRange,SUMPRODUCT(baseMask*--ovDef*--(((--curIsNonBit)+--arrIsNonBit)>0)*--(1-wholeBitPair)),
               potRange,SUMPRODUCT(baseMask*--ovPot*--(((--curIsNonBit)+--arrIsNonBit)>0)*--(1-wholeBitPair)),
               IF(directConflict+defRange>0,"CONFLICT",IF(potWholeBit+potRange>0,"POTENTIAL","OK"))
            )
         )
   ),
   IFERROR(status,"POTENTIAL")
), "EXECUTION PAUSED")