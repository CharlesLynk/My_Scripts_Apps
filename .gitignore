# Repo-wide ignore rules for My_Scripts_Apps.
# Project-specific rules live in nested .gitignore files.

# Windows system files
Thumbs.db
ehthumbs.db
desktop.ini

# Editor and IDE caches
.vs/
.vscode/
*.swp
*~

# Office lock files
~$*

# AutoCAD backup and temp files
*.bak
*.dwl
*.dwl2
*.sv$

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Logs and secrets
*.log
.env
.env.*

# Large packaged app artifacts (MSIX/AppX bundles, runtime dependencies, symbols, installers)
*.msix
*.msixbundle
*.appx
*.appxbundle
*.appxsym
*.msi
*.msp

# Large archives, disk images, and OCR model data
*.iso
*.7z
*.rar
*.traineddata
