TZ=America/New_York

# Password the Pi prints from: sudo bash camera-setup.sh --stream
FRIGATE_RTSP_PASSWORD=

# Password for the Mosquitto user "frigate". Generate with: openssl rand -hex 24
FRIGATE_MQTT_PASSWORD=

# Optional absolute path on the Linux VM; defaults to ./storage.
# FRIGATE_STORAGE_PATH=/mnt/frigate-media

# Optional: replace the tag with a verified eclipse-mosquitto@sha256:... reference.
# MOSQUITTO_IMAGE=eclipse-mosquitto:2
