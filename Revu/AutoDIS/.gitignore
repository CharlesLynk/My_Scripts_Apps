# Build output (per-platform folders from Release x64/x86/ARM64 builds)
bin/
obj/
/x64/
/x86/
/ARM64/
Generated Files/
# MSIX packaging outputs and signing keys
AppPackages/
BundleArtifacts/
*.msix
*.msixbundle
*.appxbundle
*.appxupload
*.appxsym
*.pfx
*.p12
*.pvk
*.snk
# Test and coverage output
TestResults/
*.coverage
*.coveragexml
# Visual Studio per-user files
*.user
*.suo
# Build logs
*.binlog
# Partial downloads/commits from the atomic output writer
*.partial
# Public OCR models and word list: downloaded and SHA-256 verified by OcrModels.targets on first build, so they are not committed
/tessdata/
/dictionary/english-enable.txt
# MSIX/Store artifacts and the unpacked sideload test packages are rebuildable
/reference/**/*.msix
/reference/**/*.msixbundle
/reference/**/*.appxsym
/reference/**/Dependencies/
# Local test data for the bench tools (client drawing titles, hand-read answers); recreate as described in tools/bench/README.md
/tools/bench/data/
/tools/bench/**/bin/
/tools/bench/**/obj/
