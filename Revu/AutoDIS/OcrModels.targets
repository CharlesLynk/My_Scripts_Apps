<Project>

  <!--
    Large, public, unmodified data files the OCR needs. They are not committed: the first build downloads each one,
    verifies its SHA-256 and stores it in the external per-user cache. Update the URL and hash together.
  -->
  <PropertyGroup>
    <OcrModelRoot>$([System.IO.Path]::Combine('$(AutoDISCacheRoot)', 'ocr'))</OcrModelRoot>
    <_FastOcrHash>7D4322BD2A7749724879683FC3912CB542F19906C83BCC1A52132556427170B2</_FastOcrHash>
    <_BestOcrHash>8280AED0782FE27257A68EA10FE7EF324CA0F8D85BD2FD145D1C2B560BCB66BA</_BestOcrHash>
    <_EnableHash>3F16130220645692ED49C7134E24A18504C2CA55B3C012F7290E3E77C63B1A89</_EnableHash>
  </PropertyGroup>

  <ItemGroup>
    <OcrModel Include="$(OcrModelRoot)\$(_FastOcrHash)\eng.traineddata" Link="tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Url="https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata"
              Sha256="$(_FastOcrHash)" />
    <OcrModel Include="$(OcrModelRoot)\$(_BestOcrHash)\eng_best.traineddata" Link="tessdata\eng_best.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Url="https://github.com/tesseract-ocr/tessdata_best/raw/main/eng.traineddata"
              Sha256="$(_BestOcrHash)" />
    <OcrModel Include="$(OcrModelRoot)\$(_EnableHash)\english-enable.txt" Link="dictionary\english-enable.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Url="https://raw.githubusercontent.com/dolph/dictionary/master/enable1.txt"
              Sha256="$(_EnableHash)" />
    <Content Include="@(OcrModel)" />
  </ItemGroup>

  <Target Name="FetchOcrModels" BeforeTargets="BeforeBuild;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="'$(DesignTimeBuild)' != 'true'">
    <GetFileHash Files="%(OcrModel.FullPath)" Algorithm="SHA256" Condition="Exists('%(OcrModel.FullPath)')">
      <Output TaskParameter="Items" ItemName="_CachedOcrModel" />
    </GetFileHash>
    <ItemGroup>
      <_ValidOcrModel Include="@(_CachedOcrModel)" Condition="'%(_CachedOcrModel.FileHash)' == '%(_CachedOcrModel.Sha256)'" />
      <_FetchOcrModel Include="@(OcrModel)" Exclude="@(_ValidOcrModel)" />
    </ItemGroup>
    <Exec Condition="'@(_FetchOcrModel)' != ''"
          Command="powershell.exe -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)scripts\Restore-OcrAsset.ps1&quot; -Url &quot;%(_FetchOcrModel.Url)&quot; -Sha256 &quot;%(_FetchOcrModel.Sha256)&quot; -Destination &quot;%(_FetchOcrModel.FullPath)&quot;" />
  </Target>

</Project>
